{
  "name": "tidyspec",
  "version": "0.0.0",
  "description": "Keep per-screen specs short, in Markdown, written by your coding agent. Preview them and catch stale ones.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write && biome check --write --only=assist/source/organizeImports",
    "test": "vitest run --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "tidyspec": "dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {}
}
